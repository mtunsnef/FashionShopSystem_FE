<script>
// Load data on page load
document.addEventListener('DOMContentLoaded', async function() {
    await Promise.all([loadProducts(), loadBrands()]);
    
    // Check if we're editing a product (Razor Pages logic)
    @if (Model.EditingProduct != null)
    {
        <text>
        // Set up for editing
        editingProductId = @Model.EditingProduct.ProductId;
        document.getElementById('productModalLabel').textContent = 'Edit Product';
        
        // Show current image if available
        @if (!string.IsNullOrEmpty(Model.EditingProduct.ImageUrl))
        {
            <text>
            document.getElementById('imagePreview').style.display = 'block';
            document.getElementById('previewImg').src = '@("https://localhost:7242" + Model.EditingProduct.ImageUrl)';
            </text>
        }
        else
        {
            <text>
            document.getElementById('imagePreview').style.display = 'none';
            document.getElementById('previewImg').src = '';
            </text>
        }
        
        // Show the modal
        $('#productModal').modal('show');
        </text>
    }
});
</script> 