@page "/admin/products"
@model FashionShopSystem_FE.Pages.Admin.ProductsModel
@{
    ViewData["Title"] = "Product Management";
    Layout = "~/Pages/Shared/Admin/_LayoutAdmin.cshtml";
}

@* Debug: Show categories count *@
@if (Model.Categories != null && Model.Categories.Any())
{
    <!-- Categories loaded: @Model.Categories.Count -->
}
else
{
    <!-- No categories loaded -->
}

<!-- Product Management Section Begin -->
<section class="admin-products">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="admin-content-header">
                    <h2>Product Management</h2>
                    <button class="btn btn-primary" onclick="openCreateProductModal()">
                        <i class="fa fa-plus"></i> Add New Product
                    </button>
                </div>
            </div>
        </div>

        <!-- Filters and Search -->
        <div class="row">
            <div class="col-12">
                <div class="admin-filters">
                    <div class="row">
                        <div class="col-md-3">
                            <input type="text" id="searchInput" class="form-control" placeholder="Search products..." onkeyup="filterProducts()">
                        </div>
                        <div class="col-md-2">
                                            <select id="categoryFilter" class="form-control" onchange="filterProducts()">
                    <option value="">All Categories</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.CategoryId">@category.CategoryName</option>
                    }
                </select>
                        </div>
                        <div class="col-md-2">
                            <select id="brandFilter" class="form-control" onchange="filterProducts()">
                                <option value="">All Brands</option>
                                <!-- Brands will be loaded here -->
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select id="statusFilter" class="form-control" onchange="filterProducts()">
                                <option value="">All Status</option>
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <input type="number" id="minPrice" class="form-control" placeholder="Min Price" onchange="filterProducts()">
                        </div>
                        <div class="col-md-1">
                            <button class="btn btn-secondary w-100" onclick="resetFilters()">Reset</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Products Table -->
        <div class="row">
            <div class="col-12">
                <div class="admin-table-container">
                    <div id="loadingState" class="loading-state" style="display: none;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="sr-only">Loading...</span>
                        </div>
                        <p>Loading products...</p>
                    </div>

                    <table class="table table-striped" id="productsTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Image</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Brand</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="productsTableBody">
                            <!-- Products will be loaded here -->
                        </tbody>
                    </table>

                    <div id="emptyState" class="empty-state" style="display: none;">
                        <i class="fa fa-shopping-bag"></i>
                        <h4>No products found</h4>
                        <p>No products match your current filters.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Product Management Section End -->

<!-- Create/Edit Product Modal -->
<div class="modal fade" id="productModal" tabindex="-1" aria-labelledby="productModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="productModalLabel">Add New Product</h5>
            </div>
            <div class="modal-body">
                <form id="productForm">
                    <input type="hidden" id="productId" value="@(Model.EditingProduct?.ProductId ?? 0)">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label for="productName" class="form-label">Product Name *</label>
                                <input type="text" class="form-control" id="productName" value="@(Model.EditingProduct?.ProductName ?? "")" required>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="mb-3">
                                <label for="description" class="form-label">Description</label>
                                <textarea class="form-control" id="description" rows="3">@(Model.EditingProduct?.Description ?? "")</textarea>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="price" class="form-label">Price *</label>
                                <input type="number" class="form-control" id="price" step="1" value="@(Model.EditingProduct?.Price ?? 0)" required>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="stock" class="form-label">Stock *</label>
                                <input type="number" class="form-control" id="stock" value="@(Model.EditingProduct?.Stock ?? 0)" required>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="categoryId" class="form-label">Category *</label>
                                <select class="form-control" id="categoryId" required>
                                    <option value="">Select Category</option>
                                    @foreach (var category in Model.Categories)
                                    {
                                        @if (Model.EditingProduct != null && Model.EditingProduct.CategoryId == category.CategoryId)
                                        {
                                            <option value="@category.CategoryId" selected>@category.CategoryName</option>
                                        }
                                        else
                                        {
                                            <option value="@category.CategoryId">@category.CategoryName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="brand" class="form-label">Brand</label>
                                <input type="text" class="form-control" id="brand" value="@(Model.EditingProduct?.Brand ?? "")">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="imageFile" class="form-label">Product Image</label>
                                <input type="file" class="form-control" id="imageFile" accept="image/*" onchange="previewImage(this)">
                                <small class="form-text text-muted">Select an image file (JPG, PNG, GIF, etc.)</small>
                                <div id="imagePreview" class="mt-2" style="display: none;">
                                    <img id="previewImg" src="" alt="Image preview" style="max-width: 200px; max-height: 200px; object-fit: cover; border: 1px solid #ddd; border-radius: 4px;">
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="cancelProductModal()">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveProduct()">Save Product</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this product? This action cannot be undone.</p>
                <p><strong>Product:</strong> <span id="deleteProductName"></span></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="cancelDeleteProductModal()">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDeleteProduct()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
let allProducts = [];
let filteredProducts = [];
let allBrands = [];
let editingProductId = null;
let deleteProductId = null;

// VND Currency Formatter
function formatVND(amount) {
    if (!amount) return '0 VND';
    return Math.round(amount).toLocaleString('vi-VN') + ' VND';
}

// Load data on page load
document.addEventListener('DOMContentLoaded', async function() {
    await Promise.all([loadProducts(), loadBrands()]);
});

// Load all products
async function loadProducts() {
    const token = localStorage.getItem('token');
    
    if (!token) {
        window.location.href = '/dang-nhap';
        return;
    }

    showLoading(true);

    try {
        const response = await fetch('https://localhost:7242/api/Product/Product', {
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            }
        });

        if (response.ok) {
            allProducts = await response.json();
            filteredProducts = [...allProducts];
            renderProducts(filteredProducts);
            showLoading(false);
        } else {
            console.error('Failed to load products');
            showLoading(false);
            showEmptyState(true);
        }
    } catch (error) {
        console.error('Error loading products:', error);
        showLoading(false);
        showEmptyState(true);
    }
}

// Load brands
async function loadBrands() {
    const token = localStorage.getItem('token');

    try {
        const response = await fetch('https://localhost:7242/api/Product/Brand', {
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            }
        });

        if (response.ok) {
            allBrands = await response.json();
            populateBrandOptions();
        }
    } catch (error) {
        console.error('Error loading brands:', error);
    }
}

// Populate brand options
function populateBrandOptions() {
    const brandFilter = document.getElementById('brandFilter');
    
    const brandOptions = allBrands.map(brand => 
        `<option value="${brand}">${brand}</option>`
    ).join('');
    
    brandFilter.innerHTML = '<option value="">All Brands</option>' + brandOptions;
}

// Render products table
function renderProducts(products) {
    const tbody = document.getElementById('productsTableBody');
    
    if (products.length === 0) {
        showEmptyState(true);
        return;
    }

    showEmptyState(false);
    
    tbody.innerHTML = products.map(product => `
        <tr>
            <td>${product.ProductId}</td>
            <td>
                <img src="https://localhost:7242${product.ImageUrl || '/img/product/default.jpg'}" alt="${product.ProductName}" 
                     style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;">
            </td>
            <td>${product.ProductName || 'N/A'}</td>
            <td>${getCategoryName(product.CategoryId)}</td>
            <td>${product.Brand || 'N/A'}</td>
            <td>${formatVND(product.Price)}</td>
            <td>${product.Stock || 0}</td>
            <td>
                <span class="badge ${product.IsActive ? 'bg-success' : 'bg-secondary'}">${product.IsActive ? 'Active' : 'Inactive'}</span>
            </td>
            <td>
                <div class="btn-group" role="group">
                    <button class="btn btn-outline-primary action-btn" onclick="editProduct(${product.ProductId})" title="Edit Product">
                        <i class="fa fa-edit"></i>
                    </button>
                    <button class="btn btn-outline-danger action-btn" onclick="deleteProduct(${product.ProductId}, '${product.ProductName}')" title="Delete Product">
                        <i class="fa fa-trash"></i>
                    </button>
                </div>
            </td>
        </tr>
    `).join('');
}

// Get category name by ID
function getCategoryName(categoryId) {
    const categoryFilter = document.getElementById('categoryFilter');
    if (categoryFilter) {
        const option = categoryFilter.querySelector(`option[value="${categoryId}"]`);
        return option ? option.textContent : 'N/A';
    }
    return 'N/A';
}

// Filter products
function filterProducts() {
    const searchTerm = document.getElementById('searchInput').value.toLowerCase();
    const categoryFilter = document.getElementById('categoryFilter').value;
    const brandFilter = document.getElementById('brandFilter').value;
    const statusFilter = document.getElementById('statusFilter').value;
    const minPrice = parseFloat(document.getElementById('minPrice').value) || 0;

    filteredProducts = allProducts.filter(product => {
        const matchesSearch = !searchTerm || 
            (product.ProductName && product.ProductName.toLowerCase().includes(searchTerm)) ||
            (product.Description && product.Description.toLowerCase().includes(searchTerm)) ||
            (product.Brand && product.Brand.toLowerCase().includes(searchTerm));

        const matchesCategory = !categoryFilter || product.CategoryId.toString() === categoryFilter;
        const matchesBrand = !brandFilter || product.Brand === brandFilter;
        const matchesStatus = !statusFilter || product.IsActive.toString() === statusFilter;
        const matchesPrice = !minPrice || (product.Price && product.Price >= minPrice);

        return matchesSearch && matchesCategory && matchesBrand && matchesStatus && matchesPrice;
    });

    renderProducts(filteredProducts);
}

// Reset filters
function resetFilters() {
    document.getElementById('searchInput').value = '';
    document.getElementById('categoryFilter').value = '';
    document.getElementById('brandFilter').value = '';
    document.getElementById('statusFilter').value = '';
    document.getElementById('minPrice').value = '';
    filteredProducts = [...allProducts];
    renderProducts(filteredProducts);
}

// Open create product modal
function openCreateProductModal() {
    editingProductId = null;
    document.getElementById('productModalLabel').textContent = 'Add New Product';
    document.getElementById('productForm').reset();
    document.getElementById('productId').value = '';
    
    // Clear image preview
    document.getElementById('imagePreview').style.display = 'none';
    document.getElementById('previewImg').src = '';
    
    $('#productModal').modal('show');
}

// Edit product - redirect to same page with productId to use Razor Pages logic
function editProduct(productId) {
    window.location.href = `/admin/products?productId=${productId}`;
}

// Save product (create or update)
async function saveProduct() {
    const formData = new FormData();
    
    // Add form fields to FormData
    formData.append('productName', document.getElementById('productName').value);
    formData.append('description', document.getElementById('description').value);
    formData.append('price', Math.round(parseFloat(document.getElementById('price').value) || 0));
    formData.append('stock', document.getElementById('stock').value);
    formData.append('categoryId', document.getElementById('categoryId').value);
    formData.append('brand', document.getElementById('brand').value);
    formData.append('isActive', 'true');
    
    // Add image file if selected
    const imageFile = document.getElementById('imageFile').files[0];
    if (imageFile) {
        formData.append('imageUrl', imageFile);
    }

    const token = localStorage.getItem('token');

    try {
        let response;
        
        if (editingProductId) {
            // Update product
            formData.append('productId', editingProductId);
            response = await fetch('https://localhost:7242/api/Product/Product', {
                method: 'PUT',
                headers: {
                    'Authorization': `Bearer ${token}`
                    // Note: Don't set Content-Type for FormData, browser will set it automatically with boundary
                },
                body: formData
            });
        } else {
            // Create product
            response = await fetch('https://localhost:7242/api/Product/Product', {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${token}`
                    // Note: Don't set Content-Type for FormData, browser will set it automatically with boundary
                },
                body: formData
            });
        }

        if (response.ok) {
            $('#productModal').modal('hide');
            await loadProducts();
            showSuccess(editingProductId ? 'Product updated successfully!' : 'Product created successfully!', 'Products');
        } else {
            const errorData = await response.json();
            showError('Error: ' + (errorData.message || 'Failed to save product'), 'Products');
        }
    } catch (error) {
        console.error('Error saving product:', error);
        showError('Error saving product', 'Products');
    }
}

// Delete product
function deleteProduct(productId, productName) {
    deleteProductId = productId;
    document.getElementById('deleteProductName').textContent = productName;
    $('#deleteModal').modal('show');
}

// Confirm delete product
async function confirmDeleteProduct() {
    const token = localStorage.getItem('token');

    try {
        const response = await fetch(`https://localhost:7242/api/Product/${deleteProductId}`, {
            method: 'DELETE',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            }
        });

        if (response.ok) {
            $('#deleteModal').modal('hide');
            await loadProducts();
            showSuccess('Product deleted successfully!', 'Products');
        } else {
            const errorData = await response.json();
            showError('Error: ' + (errorData.message || 'Failed to delete product'), 'Products');
        }
    } catch (error) {
        console.error('Error deleting product:', error);
        showError('Error deleting product', 'Products');
    }
}

// Utility functions
function showLoading(show) {
    document.getElementById('loadingState').style.display = show ? 'block' : 'none';
    document.getElementById('productsTable').style.display = show ? 'none' : 'table';
}

function showEmptyState(show) {
    document.getElementById('emptyState').style.display = show ? 'block' : 'none';
    document.getElementById('productsTable').style.display = show ? 'none' : 'table';
}

function cancelProductModal() {
    $('#productModal').modal('hide');
}

function cancelDeleteProductModal() {
    $('#deleteModal').modal('hide');
}

// Preview image when file is selected
function previewImage(input) {
    const previewDiv = document.getElementById('imagePreview');
    const previewImg = document.getElementById('previewImg');
    
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        
        reader.onload = function(e) {
            previewImg.src = e.target.result;
            previewDiv.style.display = 'block';
        };
        
        reader.readAsDataURL(input.files[0]);
    } else {
        previewDiv.style.display = 'none';
        previewImg.src = '';
    }
}
</script>

