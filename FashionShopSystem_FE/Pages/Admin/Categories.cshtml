@page "/admin/categories"
@model FashionShopSystem_FE.Pages.Admin.CategoriesModel
@{
    ViewData["Title"] = "Categories Management";
    Layout = "~/Pages/Shared/Admin/_LayoutAdmin.cshtml";
}

<!-- Categories Management Section Begin -->
<section class="admin-categories">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12">
                <div class="admin-content-header">
                    <h2>Categories Management</h2>
                    <button type="button" class="btn btn-primary" onclick="openAddCategory()">
                        <i class="fa fa-plus"></i> Add New Category
                    </button>
                </div>

                <!-- Categories Grid -->
                <div class="admin-table-container">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Category Name</th>
                                    <th>Description</th>
                                    <th>Products Count</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="categoriesTableBody">
                                <!-- Categories will be loaded here -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Loading and Empty States -->
                <div id="loadingState" class="text-center py-4">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading categories...</p>
                </div>

                <div id="emptyState" class="text-center py-4" style="display: none;">
                    <i class="fa fa-folder-open fa-3x text-muted mb-3"></i>
                    <h4>No Categories Found</h4>
                    <p class="text-muted">Start by adding your first category.</p>
                    <button class="btn btn-primary" onclick="openAddCategory()">
                        <i class="fa fa-plus"></i> Add Category
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Add/Edit Category Modal -->
<div class="modal fade" id="categoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="categoryModalTitle">Add Category</h5>
            </div>
            <div class="modal-body">
                <form id="categoryForm">
                    <input type="hidden" id="categoryId">
                    <div class="mb-3">
                        <label for="categoryName" class="form-label">Category Name *</label>
                        <input type="text" class="form-control" id="categoryName" required maxlength="100">
                    </div>
                    <div class="mb-3">
                        <label for="categoryDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="categoryDescription" rows="3" maxlength="255"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="cancelCategoryModal()">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveCategory()">
                    <span id="saveButtonText">Save Category</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this category?</p>
                <p class="text-warning"><strong>Warning:</strong> This action cannot be undone. All products in this category will need to be reassigned.</p>
                <input type="hidden" id="deleteCategoryId">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="cancelDeleteModal()">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete Category</button>
            </div>
        </div>
    </div>
</div>

<script>
let allCategories = [];

document.addEventListener('DOMContentLoaded', function() {
    loadCategories();
});

async function loadCategories() {
    try {
        const token = localStorage.getItem('token');
        const response = await fetch('https://localhost:7242/api/Category/Category', {
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            }
        });

        if (response.ok) {
            const categories = await response.json();
            allCategories = categories;
            displayCategories(categories);
        } else {
            console.error('Failed to load categories');
            showError('Failed to load categories');
        }
    } catch (error) {
        console.error('Error loading categories:', error);
        showError('Error loading categories');
    } finally {
        document.getElementById('loadingState').style.display = 'none';
    }
}

function displayCategories(categories) {
    const tbody = document.getElementById('categoriesTableBody');
    
    if (categories.length === 0) {
        document.getElementById('emptyState').style.display = 'block';
        tbody.innerHTML = '';
        return;
    }

    document.getElementById('emptyState').style.display = 'none';
    
    tbody.innerHTML = categories.map(category => `
        <tr>
            <td><strong>${category.CategoryId}</strong></td>
            <td>${category.CategoryName}</td>
            <td>${category.Description || 'No description'}</td>
            <td>
                <span class="badge bg-info">${category.productsCount || 0} products</span>
            </td>
            <td>
                <div class="btn-group" role="group">
                    <button class="btn btn-warning action-btn" onclick="editCategory(${category.CategoryId})" title="Edit Category">
                        <i class="fa fa-edit"></i>
                    </button>
                    <button class="btn btn-danger action-btn" onclick="openDeleteModal(${category.CategoryId})" title="Delete Category">
                        <i class="fa fa-trash"></i>
                    </button>
                </div>
            </td>
        </tr>
    `).join('');
}

function openAddCategory() {
    document.getElementById('categoryModalTitle').textContent = 'Add Category';
    document.getElementById('saveButtonText').textContent = 'Save Category';
    document.getElementById('categoryForm').reset();
    document.getElementById('categoryId').value = '';
    $('#categoryModal').modal('show');
}

async function editCategory(categoryId) {
    try {
        const token = localStorage.getItem('token');
        const response = await fetch(`https://localhost:7242/api/Category/${categoryId}`, {
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            }
        });

        if (response.ok) {
            const category = await response.json();
            
            document.getElementById('categoryModalTitle').textContent = 'Edit Category';
            document.getElementById('saveButtonText').textContent = 'Update Category';
            document.getElementById('categoryId').value = category.CategoryId;
            document.getElementById('categoryName').value = category.CategoryName;
            document.getElementById('categoryDescription').value = category.Description || '';
            
            $('#categoryModal').modal('show');
        } else {
            showError('Failed to load category details');
        }
    } catch (error) {
        console.error('Error loading category details:', error);
        showError('Error loading category details');
    }
}

async function saveCategory() {
    const categoryId = document.getElementById('categoryId').value;
    const categoryName = document.getElementById('categoryName').value.trim();
    const categoryDescription = document.getElementById('categoryDescription').value.trim();

    if (!categoryName) {
        showError('Category name is required');
        return;
    }

    try {
        const token = localStorage.getItem('token');
        let url, method, categoryData;

        if (categoryId) {
            // Update existing category
            url = 'https://localhost:7242/api/Category/Category';
            method = 'PUT';
            categoryData = {
                Id: parseInt(categoryId),
                Name: categoryName,
                decription: categoryDescription || ""
            };
        } else {
            // Create new category
            url = 'https://localhost:7242/api/Category/Category';
            method = 'POST';
            categoryData = {
                Name: categoryName,
                decription: categoryDescription || ""
            };
        }

        const response = await fetch(url, {
            method: method,
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(categoryData)
        });

        if (response.ok) {
            const responseData = await response.json();
            console.log('Category save response:', responseData);
            const message = categoryId ? 'Category updated successfully' : 'Category created successfully';
            showSuccess(message);
            loadCategories(); // Reload the categories
            
            // Hide modal (using Bootstrap 4 syntax)
            $('#categoryModal').modal('hide');
        } else {
            const errorData = await response.text();
            console.error('Category save error:', {
                status: response.status,
                statusText: response.statusText,
                error: errorData,
                sentData: categoryData
            });
            showError(`Failed to save category (${response.status}): ${errorData || response.statusText}`);
        }
    } catch (error) {
        console.error('Error saving category:', error);
        showError('Error saving category');
    }
}

function openDeleteModal(categoryId) {
    document.getElementById('deleteCategoryId').value = categoryId;
    $('#deleteModal').modal('show');
}

async function confirmDelete() {
    const categoryId = document.getElementById('deleteCategoryId').value;
    
    try {
        const token = localStorage.getItem('token');
        const response = await fetch(`https://localhost:7242/api/Category/${categoryId}`, {
            method: 'DELETE',
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            }
        });

        if (response.ok) {
            showSuccess('Category deleted successfully');
            loadCategories(); // Reload the categories
            $('#deleteModal').modal('hide');
        } else {
            const errorData = await response.text();
            showError(`Failed to delete category: ${errorData}`);
        }
    } catch (error) {
        console.error('Error deleting category:', error);
        showError('Error deleting category');
    }
}

function cancelCategoryModal() {
    $('#categoryModal').modal('hide');
}

function cancelDeleteModal() {
    $('#deleteModal').modal('hide');
}

// Notification functions are now available globally from _LayoutAdmin.cshtml
</script>

