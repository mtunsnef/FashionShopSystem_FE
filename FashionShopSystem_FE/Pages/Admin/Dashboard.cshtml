@page "/admin"
@model FashionShopSystem_FE.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Pages/Shared/Admin/_LayoutAdmin.cshtml";
}

<!-- Dashboard Section Begin -->
<section class="admin-dashboard">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="dashboard-header">
                    <h2>Admin Dashboard</h2>
                    <p>Welcome to the Fashion Shop administration panel</p>
                </div>
            </div>
        </div>

        <div class="row dashboard-stats">
            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fa fa-users"></i>
                    </div>
                    <div class="stat-info">
                        <h3 id="totalUsers">Loading...</h3>
                        <p>Total Users</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fa fa-shopping-bag"></i>
                    </div>
                    <div class="stat-info">
                        <h3 id="totalProducts">Loading...</h3>
                        <p>Total Products</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fa fa-list-alt"></i>
                    </div>
                    <div class="stat-info">
                        <h3 id="totalOrders">Loading...</h3>
                        <p>Total Orders</p>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="stat-card">
                    <div class="stat-icon">
                        <i class="fa fa-dollar"></i>
                    </div>
                    <div class="stat-info">
                        <h3 id="totalRevenue">Loading...</h3>
                        <p>Total Revenue</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row quick-actions">
            <div class="col-12">
                <div class="section-title">
                    <h3>Quick Actions</h3>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="action-card" onclick="location.href='/admin/users'">
                    <div class="action-icon">
                        <i class="fa fa-users"></i>
                    </div>
                    <h4>Manage Users</h4>
                    <p>View, create, edit and delete user accounts</p>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="action-card" onclick="location.href='/admin/products'">
                    <div class="action-icon">
                        <i class="fa fa-shopping-bag"></i>
                    </div>
                    <h4>Manage Products</h4>
                    <p>View, create, edit and delete products</p>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="action-card" onclick="location.href='/admin/orders'">
                    <div class="action-icon">
                        <i class="fa fa-list-alt"></i>
                    </div>
                    <h4>Manage Orders</h4>
                    <p>View and manage customer orders</p>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="action-card" onclick="location.href='/admin/categories'">
                    <div class="action-icon">
                        <i class="fa fa-tags"></i>
                    </div>
                    <h4>Manage Categories</h4>
                    <p>View, create, edit and delete categories</p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Dashboard Section End -->

<script>
document.addEventListener('DOMContentLoaded', async function() {
    await loadDashboardStats();
});

async function loadDashboardStats() {
    const token = localStorage.getItem('token');
    
    if (!token) {
        window.location.href = '/dang-nhap';
        return;
    }

    try {
        // Load users count
        const usersResponse = await fetch('https://localhost:7242/api/User', {
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            }
        });
        
        if (usersResponse.ok) {
            const users = await usersResponse.json();
            document.getElementById('totalUsers').textContent = users.length;
        }

        // Load products count
        const productsResponse = await fetch('https://localhost:7242/api/Product/Product', {
            headers: {
                'Authorization': `Bearer ${token}`,
                'Content-Type': 'application/json'
            }
        });
        
        if (productsResponse.ok) {
            const products = await productsResponse.json();
            document.getElementById('totalProducts').textContent = Array.isArray(products) ? products.length : 0;
        }

        // Placeholder for orders and revenue (implement when API is available)
        document.getElementById('totalOrders').textContent = '0';
        document.getElementById('totalRevenue').textContent = '$0.00';

    } catch (error) {
        console.error('Error loading dashboard stats:', error);
        document.getElementById('totalUsers').textContent = 'Error';
        document.getElementById('totalProducts').textContent = 'Error';
        document.getElementById('totalOrders').textContent = 'Error';
        document.getElementById('totalRevenue').textContent = 'Error';
    }
}
</script>

<style>
.admin-dashboard {
    padding: 30px 0;
    background: #f8f9fa;
    min-height: 100vh;
}

.dashboard-header {
    text-align: center;
    margin-bottom: 40px;
    padding: 20px;
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 0 20px rgba(0,0,0,0.1);
}

.dashboard-header h2 {
    color: #333;
    margin-bottom: 10px;
}

.dashboard-header p {
    color: #666;
    margin: 0;
}

.dashboard-stats {
    margin-bottom: 40px;
}

.stat-card {
    background: #fff;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 0 20px rgba(0,0,0,0.1);
    display: flex;
    align-items: center;
    margin-bottom: 20px;
    transition: transform 0.3s;
}

.stat-card:hover {
    transform: translateY(-5px);
}

.stat-icon {
    width: 60px;
    height: 60px;
    background: #ca1515;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 20px;
}

.stat-icon i {
    color: #fff;
    font-size: 24px;
}

.stat-info h3 {
    font-size: 32px;
    font-weight: bold;
    color: #333;
    margin: 0;
}

.stat-info p {
    color: #666;
    margin: 5px 0 0;
}

.quick-actions {
    margin-top: 20px;
}

.section-title {
    margin-bottom: 30px;
}

.section-title h3 {
    color: #333;
    font-weight: 600;
    padding-bottom: 10px;
    border-bottom: 3px solid #ca1515;
    display: inline-block;
}

.action-card {
    background: #fff;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 0 20px rgba(0,0,0,0.1);
    text-align: center;
    cursor: pointer;
    transition: all 0.3s;
    margin-bottom: 20px;
    border: 2px solid transparent;
}

.action-card:hover {
    transform: translateY(-5px);
    border-color: #ca1515;
}

.action-icon {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #ca1515, #e83a3a);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
}

.action-icon i {
    color: #fff;
    font-size: 32px;
}

.action-card h4 {
    color: #333;
    margin-bottom: 10px;
    font-weight: 600;
}

.action-card p {
    color: #666;
    margin: 0;
    font-size: 14px;
}

/* Responsive */
@@media (max-width: 768px) {
    .admin-dashboard {
        padding: 20px 0;
    }
    
    .dashboard-header {
        margin-bottom: 30px;
        padding: 15px;
    }
    
    .stat-card {
        padding: 20px;
        margin-bottom: 15px;
    }
    
    .stat-icon {
        width: 50px;
        height: 50px;
        margin-right: 15px;
    }
    
    .stat-icon i {
        font-size: 20px;
    }
    
    .stat-info h3 {
        font-size: 24px;
    }
    
    .action-card {
        padding: 20px;
        margin-bottom: 15px;
    }
    
    .action-icon {
        width: 60px;
        height: 60px;
        margin-bottom: 15px;
    }
    
    .action-icon i {
        font-size: 24px;
    }
}
</style> 