@page "/yeu-thich"
@model FashionShopSystem_FE.Pages.Client.FavouriteModel
@{
    ViewData["Title"] = "Danh sách yêu thích";
}

<h2 >Danh sách yêu thích</h2>
<table class="fav-table-header">
    <thead>
        <tr>
            <th>Ảnh</th>
            <th>Tên</th>
            <th>Giá</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody id="favouriteList">
        <!-- Dữ liệu sẽ render bằng JS -->
    </tbody>
</table>


<style>
    h2 {
        text-align: center;
    }
    .favourite-container {
        max-width: 900px;
        margin: 0 auto;
        font-family: Arial, sans-serif;
    }

    /* Bảng tiêu đề */
    .fav-table-header {
        width: 80%;
        margin: 0 auto; /* Căn giữa bảng */
        border-collapse: collapse;
        margin-top: 2%;
        margin-bottom: 20%;
        font-family: Arial, sans-serif;
        text-align:center;
    }

        .fav-table-header th {
            text-align: left;
            padding: 10px 12px;
            background-color: #f5f5f5;
            border-bottom: 2px solid #ddd;
            font-size: 0.95rem;
            color: #555;
            text-align: center;
        }

        .fav-table-header td {
            padding: 10px 12px;
        }

        .fav-table-header a {
            color : black;
        }

    /* Danh sách từng dòng */
    .fav-item {
        display: grid;
        grid-template-columns: 80px 1fr 120px 100px; /* 4 cột: ảnh - tên - giá - hành động */
        align-items: center;
        border: 1px solid #ddd;
        padding: 12px;
        margin-bottom: 12px;
        border-radius: 6px;
        background: #fff;
        gap: 12px;
    }

    /* Ảnh */
    .fav-image img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 4px;
    }

    /* Tên sản phẩm */
    .fav-name {
        font-weight: 600;
        font-size: 1rem;
        color: #333;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Giá sản phẩm */
    .fav-price {
        color: #e53935;
        font-weight: bold;
        font-size: 1rem;
    }

    /* Hành động */
    .fav-actions {
        display: flex;
        justify-content: flex-end;
    }

    .btn-remove {
        color: #f44336;
        border: none;
        background: none;
        cursor: pointer;
        font-weight: 600;
    }

        .btn-remove:hover {
            text-decoration: underline;
        }

</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async () => {
            const token = localStorage.getItem("token");
            const container = document.getElementById("favouriteList");

            if (!token) {
                container.innerText = "Bạn chưa đăng nhập.";
                return;
            }

            try {
                const response = await fetch("https://localhost:7242/api/Favourite/FavouriteByUserId", {
                    method: "GET",
                    headers: {
                        "Authorization": `Bearer ${token}`
                    }
                });

                if (response.ok) {
                    const apiResult = await response.json();
                    const favourites = apiResult.Data;

                    if (!favourites || favourites.length === 0) {
                                container.innerHTML = `
            <tr>
                <td colspan="4" style="text-align: center; padding: 20px; color: #888;">
                    Không có sản phẩm yêu thích.
                </td>
            </tr>
        `;
                        return;
                    }
        const listHtml = favourites.map(item => `
            <tr>
                <td><img src="https://localhost:7242${item.Product.ImageUrl}" alt="${item.Product.ProductName}" style="width: 60px; height: 60px; object-fit: cover;" /></td>
               <td>
            <a href="/chi-tiet-cua-hang/${item.Product.ProductId}">
                <strong>${item.Product.ProductName}</strong>
            </a>
        </td>
                <td style="color: red; font-weight: bold;">${item.Product.Price.toLocaleString()} VND</td>
                <td><button class="btn-remove" onclick="removeFavourite(${item.FavoriteId})">Xóa</button></td>
            </tr>
        `).join("");


                    container.innerHTML = listHtml;
                } else {
                    container.innerText = "Không thể tải danh sách yêu thích.";
                }
            } catch (error) {
                console.error(error);
                container.innerText = "Lỗi khi tải dữ liệu.";
            }
        });

        async function removeFavourite(id) {
            const token = localStorage.getItem("token");
            if (!confirm("Bạn có chắc muốn xóa mục này khỏi yêu thích?")) return;

            const res = await fetch(`https://localhost:7242/api/Favourite/${id}`, {
                method: "DELETE",
                headers: {
                    "Authorization": `Bearer ${token}`
                }
            });

            if (res.ok) {
                alert("Đã xóa!");
                location.reload();
            } else {
                alert("Xóa thất bại!");
            }
        }
    </script>
}
